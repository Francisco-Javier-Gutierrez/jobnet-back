# ==============================================================================
# JobNet Backend Environment Variables Configuration Template (.env.example)
# ==============================================================================

# Servidor Local Express
PORT=3001

# AWS DynamoDB & S3 Storage
TABLE_NAME=JobNet-MainTable
AWS_REGION=us-east-1
S3_BUCKET_NAME=jobnet-media-storage

# ------------------------------------------------------------------------------
# SERVICIOS DE INTELIGENCIA ARTIFICIAL (IA)
# Proveedores soportados: "deepseek" | "gemini" | "openai"
# ------------------------------------------------------------------------------

# Proveedor global por defecto (si no se especifica uno por tarea)
AI_PROVIDER=deepseek

# Credenciales y URLs base generales
DEEPSEEK_API_KEY=sk-tu-api-key-de-deepseek-aqui
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

GEMINI_API_KEY=AQ.tu-api-key-de-gemini-aqui
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# ------------------------------------------------------------------------------
# 1. MODERACIÓN DE CONTENIDO CON IA (Publicaciones, Comentarios, Vacantes, Media)
# ------------------------------------------------------------------------------
# Proveedor específico para moderación (opcional, defaults to AI_PROVIDER)
AI_MODERATION_PROVIDER=deepseek

# Modelo específico para moderación (ej. deepseek-chat, gemini-2.0-flash, gpt-4o-mini)
# Modelos rápidos y económicos con baja latencia
AI_MODERATION_MODEL=deepseek-chat

# Credenciales específicas de moderación (opcional, si se usan cuentas separadas)
# AI_MODERATION_API_KEY=
# AI_MODERATION_API_URL=

# ------------------------------------------------------------------------------
# 2. MOTOR DE RAZONAMIENTO Y ATS DE CANDIDATOS (Ranking y Resúmenes Ejecutivos)
# ------------------------------------------------------------------------------
# Proveedor específico para razonamiento y ATS (opcional, defaults to AI_PROVIDER)
AI_REASONING_PROVIDER=deepseek

# Modelo específico para razonamiento avanzado y ranking comparativo de candidatos
# Puede usar modelos de razonamiento como deepseek-reasoner, o3-mini o gemini-2.0-pro
AI_REASONING_MODEL=deepseek-chat

# Credenciales específicas de razonamiento (opcional)
# AI_REASONING_API_KEY=
# AI_REASONING_API_URL=
